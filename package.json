{
  "name": "smart-gd",
  "version": "1.0.0",
  "private": true,
  "description": "Smart GD - AI-powered Group Discussion Platform",
  "scripts": {
    "dev": "cd frontend && npm run dev",
    "frontend": "cd frontend && npm run dev",
    "functions": "cd functions && npm run serve",
